#!/usr/bin/env bash
#
# dns-changer — privileged DNS helper for the Omarchy DNS Changer bar plugin.
#
# Mirrors the Linux backend of github.com/DnsChanger/dnschanger-cli
# (src/platforms/linux/linux.platform.ts) as closely as an unsandboxed
# Quickshell plugin can call it:
#
#   setDns()    -> write /etc/resolv.conf, restart systemd-networkd
#   clearDns()  -> setDns(["1.1.1.1","8.8.8.8","192.168.1.1","127.0.0.1"])
#   getActiveDns() -> grep nameserver /etc/resolv.conf
#   flushDns()  -> systemd-resolve --flush-caches (resolvectl on modern systemd)
#
# The original CLI shells out through `sudo-prompt`, which on Linux resolves
# to a graphical polkit/pkexec prompt; we use pkexec directly for the same
# one-shot elevation, once per privileged action.
#
#   dns-changer active                 -> { ok, servers:[ip, ...] }
#   dns-changer connect <ip> [ip2]     -> { ok, servers:[...] } | { ok:false, error }
#   dns-changer disconnect             -> same shape, servers = the CLI's defaults
#   dns-changer flush                  -> { ok }
#   dns-changer fetch-servers          -> the DnsChanger server catalog, sorted by rate desc
#   dns-changer ping <ip> [ip...]      -> { ok, results: { ip: ms|null, ... } }
#   dns-changer favicons <domain>...   -> { ok, results: { domain: path|null, ... } }
#
# `ping` and `favicons` are plugin additions (not part of the original CLI,
# which has neither a latency nor a provider-icon feature):
#   - ping: one ICMP echo per address, run in parallel with a 1s timeout, so
#     pinging the whole catalog stays fast even on a cold link.
#   - favicons: fetches each domain's real favicon (DuckDuckGo's icon
#     service — nothing bundled/redistributed) and caches it locally,
#     returning a local file path only for a genuine icon. DuckDuckGo's
#     service serves an identical ~1.4KB generic placeholder PNG for ANY
#     domain it has no real icon for rather than failing — verified against
#     a domain that cannot exist — so that exact response is detected by
#     hash and reported as null (falls back to a generated badge) instead of
#     being shown as if it were the provider's real logo.
#
# Dependencies: curl, jq, pkexec, ping (iputils), md5sum (coreutils).

set -o pipefail

STORE_URL="https://raw.githubusercontent.com/DnsChanger/dnsChanger-desktop/store/servers_DB.json"
DEFAULT_DNS=(1.1.1.1 8.8.8.8 192.168.1.1 127.0.0.1)
CACHE_DIR="${DNS_CHANGER_CACHE_DIR:-$HOME/.cache/omarchy-dns-changer}"
FAVICON_DIR="$CACHE_DIR/favicons"
mkdir -p "$CACHE_DIR" "$FAVICON_DIR" 2>/dev/null || true

# The exact bytes DuckDuckGo's icon service returns for a domain it has no
# real favicon for (md5 of a known-nonexistent domain's response, 2026-09-19).
PLACEHOLDER_FAVICON_MD5="ab1fb25b83d4b333ea661a84bd298b2e"

die() {
  printf '{"ok":false,"error":%s}\n' "$(jq -nc --arg m "$1" '$m')" >&2
  printf '{"ok":false,"error":%s}\n' "$(jq -nc --arg m "$1" '$m')"
  exit 0
}

is_valid_ip() {
  [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
}

ips_to_json() {
  # $@ -> compact JSON array of strings (empty array for no args).
  if [ "$#" -eq 0 ]; then
    printf '[]'
    return
  fi
  printf '%s\n' "$@" | jq -R . | jq -sc .
}

cmd_active() {
  local ips=()
  while IFS= read -r line; do
    [ -n "$line" ] && ips+=("$line")
  done < <(grep -h '^nameserver' /etc/resolv.conf 2>/dev/null | awk '{print $2}')
  printf '{"ok":true,"servers":%s}\n' "$(ips_to_json "${ips[@]}")"
}

# apply_dns <ip> [ip2 ...] — validates, writes /etc/resolv.conf as root via
# pkexec, restarts systemd-networkd, then flushes the resolver cache. The
# nameserver block is passed as $1 inside the elevated shell (not
# interpolated into the script text) so nothing here depends on shell
# quoting of externally-derived data.
apply_dns() {
  local ips=("$@") lines="" i
  [ "${#ips[@]}" -eq 0 ] && die "connect requires at least one DNS address"
  for i in "${ips[@]}"; do
    is_valid_ip "$i" || die "invalid DNS address: $i"
    lines+="nameserver ${i}"$'\n'
  done

  # Matches setDns() exactly: write resolv.conf, restart systemd-networkd.
  # No cache flush here — the CLI's setDns() doesn't call flushDns() either
  # (flushDns exists on the platform/service layer but isn't wired to any
  # CLI command); this plugin exposes it separately via `flush`/the panel's
  # flush-cache button instead.
  pkexec sh -c '
    printf "%s" "$1" > /etc/resolv.conf &&
    { systemctl restart systemd-networkd 2>/dev/null || true; }
  ' _ "$lines" || die "failed to apply DNS (cancelled or command failed)"

  printf '{"ok":true,"servers":%s}\n' "$(ips_to_json "${ips[@]}")"
}

cmd_connect() {
  apply_dns "$@"
}

cmd_disconnect() {
  apply_dns "${DEFAULT_DNS[@]}"
}

cmd_flush() {
  pkexec sh -c 'resolvectl flush-caches 2>/dev/null || systemd-resolve --flush-caches 2>/dev/null || true' \
    || die "failed to flush DNS cache"
  printf '{"ok":true}\n'
}

cmd_fetch_servers() {
  local raw
  raw="$(curl -fsS --max-time 12 "$STORE_URL" 2>/dev/null)" || die "could not reach the server list"
  printf '%s' "$raw" | jq -e 'type == "array"' >/dev/null 2>&1 || die "unexpected server list format"
  printf '%s' "$raw" | jq -c 'sort_by(-.rate)'
}

# One `ping -c 1 -W 1` per address, fired in parallel and collected via a
# per-address temp file (command substitution inside a backgrounded subshell
# can't be joined any other way without races — same rationale as
# fetch-chand's resolve_to_file).
cmd_ping() {
  local ips=("$@")
  if [ "${#ips[@]}" -eq 0 ]; then
    printf '{"ok":true,"results":{}}\n'
    return
  fi

  local tmpdir; tmpdir="$(mktemp -d)"
  local ip slot pids=()
  for ip in "${ips[@]}"; do
    slot="$tmpdir/$(printf '%s' "$ip" | tr -c '0-9A-Za-z' '_')"
    (
      ping -c 1 -W 1 "$ip" 2>/dev/null \
        | awk -F'time=' '/time=/ { split($2, a, " "); print a[1]; exit }' \
        > "$slot"
    ) &
    pids+=("$!")
  done
  local pid
  for pid in "${pids[@]}"; do wait "$pid" 2>/dev/null; done

  local json="{}" val
  for ip in "${ips[@]}"; do
    slot="$tmpdir/$(printf '%s' "$ip" | tr -c '0-9A-Za-z' '_')"
    val="$(cat "$slot" 2>/dev/null)"
    if [[ "$val" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
      json="$(printf '%s' "$json" | jq -c --arg ip "$ip" --argjson v "$val" '. + {($ip): $v}')"
    else
      json="$(printf '%s' "$json" | jq -c --arg ip "$ip" '. + {($ip): null}')"
    fi
  done
  rm -rf "$tmpdir"
  printf '{"ok":true,"results":%s}\n' "$json"
}

domain_slug() {
  printf '%s' "$1" | tr -c '0-9A-Za-z.' '_'
}

# Fetches, hash-checks against the placeholder, and caches one domain's
# favicon; writes the local path to $2 only for a genuine icon (leaves $2
# absent/empty otherwise). Runs backgrounded per-domain in cmd_favicons.
BROWSER_UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# Tier 2: some sites (verified: asiatech.ir) aren't in DuckDuckGo's crawl at
# all but serve their own favicon fine — fetch the homepage with a browser
# User-Agent (plain curl gets 307-looped by at least one site's bot
# mitigation) and use whatever <link rel=icon> it declares.
extract_icon_url() {
  python3 -c '
import re, sys
from urllib.parse import urljoin
try:
    html = open(sys.argv[1], "r", errors="ignore").read()
except OSError:
    sys.exit(0)
base = sys.argv[2]
for tag in re.findall(r"<link[^>]+rel=[\"\x27]?(?:shortcut )?icon[\"\x27]?[^>]*>", html, re.I):
    m = re.search(r"href=[\"\x27]([^\"\x27]+)[\"\x27]", tag, re.I)
    if m:
        print(urljoin(base, m.group(1)))
        break
' "$1" "$2" 2>/dev/null
}

# Fetches $1 into $2, accepting it only if it's actually image data (a
# site's HTML error page saved under an image-looking URL would otherwise
# get cached and shown as an icon).
fetch_image_url() {
  curl -fsSL -A "$BROWSER_UA" --max-time 8 "$1" -o "$2" 2>/dev/null || return 1
  [ -s "$2" ] || return 1
  file --mime-type -b "$2" 2>/dev/null | grep -q '^image/' || return 1
  return 0
}

fetch_favicon_from_site() {
  local domain="$1" out="$2" base="https://${1}/"
  local html; html="$(mktemp)"
  if curl -fsSL -A "$BROWSER_UA" --max-time 8 "$base" -o "$html" 2>/dev/null; then
    local iconurl; iconurl="$(extract_icon_url "$html" "$base")"
    rm -f "$html"
    if [ -n "$iconurl" ] && fetch_image_url "$iconurl" "$out"; then
      return 0
    fi
  else
    rm -f "$html"
  fi
  # Last resort: the conventional /favicon.ico location, in case the site's
  # own <link rel=icon> is missing or stale (verified: dns.watch declares
  # one that itself 404s).
  fetch_image_url "${base}favicon.ico" "$out"
}

fetch_one_favicon() {
  local domain="$1" resultfile="$2"
  local slug; slug="$(domain_slug "$domain")"
  local cached="$FAVICON_DIR/$slug.ico"
  if [ -s "$cached" ]; then
    printf '%s' "$cached" >"$resultfile"
    return
  fi
  local tmp; tmp="$(mktemp)"
  if curl -fsS --max-time 8 "https://icons.duckduckgo.com/ip3/${domain}.ico" -o "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    local hash; hash="$(md5sum "$tmp" | cut -d' ' -f1)"
    if [ "$hash" != "$PLACEHOLDER_FAVICON_MD5" ]; then
      mv "$tmp" "$cached"
      printf '%s' "$cached" >"$resultfile"
      return
    fi
  fi
  rm -f "$tmp"

  if fetch_favicon_from_site "$domain" "$cached"; then
    printf '%s' "$cached" >"$resultfile"
    return
  fi
  rm -f "$cached"
}

cmd_favicons() {
  local domains=("$@")
  if [ "${#domains[@]}" -eq 0 ]; then
    printf '{"ok":true,"results":{}}\n'
    return
  fi

  local tmpdir; tmpdir="$(mktemp -d)"
  local d slug pids=()
  for d in "${domains[@]}"; do
    slug="$(domain_slug "$d")"
    (fetch_one_favicon "$d" "$tmpdir/$slug.result") &
    pids+=("$!")
  done
  local pid
  for pid in "${pids[@]}"; do wait "$pid" 2>/dev/null; done

  local json="{}" path
  for d in "${domains[@]}"; do
    slug="$(domain_slug "$d")"
    if [ -s "$tmpdir/$slug.result" ]; then
      path="$(cat "$tmpdir/$slug.result")"
      json="$(printf '%s' "$json" | jq -c --arg d "$d" --arg p "$path" '. + {($d): $p}')"
    else
      json="$(printf '%s' "$json" | jq -c --arg d "$d" '. + {($d): null}')"
    fi
  done
  rm -rf "$tmpdir"
  printf '{"ok":true,"results":%s}\n' "$json"
}

case "${1:-}" in
  active)        cmd_active ;;
  connect)       shift; cmd_connect "$@" ;;
  disconnect)    cmd_disconnect ;;
  flush)         cmd_flush ;;
  fetch-servers) cmd_fetch_servers ;;
  ping)          shift; cmd_ping "$@" ;;
  favicons)      shift; cmd_favicons "$@" ;;
  *) die "usage: dns-changer active | connect <ip> [ip2] | disconnect | flush | fetch-servers | ping <ip>... | favicons <domain>..." ;;
esac
